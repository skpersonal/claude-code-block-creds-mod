{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["hooks/**", "tests/*.ts", "*.json", ".claude-plugin/*.json"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "asNeeded", "trailingCommas": "all" } },
  "linter": {
    "rules": {
      "style": { "useTemplate": "off" },
      "complexity": { "useLiteralKeys": "off" },
      "correctness": { "noUnusedFunctionParameters": "off" }
    }
  },
  "overrides": [{ "includes": ["tests/*.ts"], "linter": { "rules": { "suspicious": { "noExplicitAny": "off" }, "style": { "noNonNullAssertion": "off" } } } }]
}
